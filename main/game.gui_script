local game = require("main.game")

local N = game.W
local M = game.H
local ZONE = game.ZONE
local ZONE_X = game.ZONE_X
local ZONE_Y = game.ZONE_Y

-- Отступы интерфейса — в долях от размера сцены, чтобы пропорции не зависели
-- от разрешения и масштаба экрана.
local MARGIN_TOP_R = 0.165   -- 132 px при высоте 800
local MARGIN_BOTTOM_R = 0.145 -- 116 px при высоте 800
local MARGIN_SIDE_R = 0.048  -- 20 px при ширине 420

-- Разрешение одной клетки в текстуре поля.
local CELL_PX = 8

local TEX_ID = "board_tx"
local TEX_W = N * CELL_PX
local TEX_H = M * CELL_PX

-- Толщина контура и свечения — в долях от размера клетки поля.
local FRAME_T_R = 0.26
local FRAME_GLOW_T_R = 1.05
local FRAME_GLOW_ALPHA = 0.16

-- Длительность анимации возврата детали в центр (секунды).
local RETURN_DURATION = 0.22

-- Высота подсветки верхней грани клетки детали (доля клетки).
local PIECE_HI_R = 0.18

-- Палитра клеток (RGB 0..255).
local CELL_RGB = {
	{ 61, 199, 240 },
	{ 250, 209, 69 },
	{ 184, 117, 242 },
	{ 92, 219, 133 },
	{ 245, 112, 112 },
	{ 97, 148, 250 },
	{ 250, 158, 71 },
}

-- Цвет фона поля и пустых клеток (сетка не рисуется).
local RGB_EMPTY = { 21, 27, 39 }
-- Чуть более светлый фон клеток внутри зоны появления.
local RGB_ZONE = { 28, 36, 52 }

-- Цвета контура: зелёный -> жёлтый -> красный.
local COLOR_OK = { 62, 226, 124 }
local COLOR_WARN = { 246, 212, 66 }
local COLOR_BAD = { 246, 62, 62 }

local COLOR_TEXT = vmath.vector4(0.92, 0.95, 1.0, 1.0)
local COLOR_TEXT_DIM = vmath.vector4(0.60, 0.67, 0.80, 1.0)

local HINT_PLAY = "Тащи деталь к краю или к фигуре"
local HINT_DRAG_OK = "Отпусти — деталь останется"
local HINT_DRAG_BAD = "Нет опоры — вернётся в центр"
local HINT_GAMEOVER = "Тап — новая игра"

local function rgb_str(rgb)
	return string.char(rgb[1], rgb[2], rgb[3])
end

--- Собирает блок CELL_PX x CELL_PX без рамки: мягкий объём по вертикали.
local function make_block(rgb)
	local r, g, b = rgb[1], rgb[2], rgb[3]
	local function clamp(v)
		if v < 0 then return 0 elseif v > 255 then return 255 end
		return math.floor(v)
	end

	local top = rgb_str({ clamp(r * 1.12), clamp(g * 1.12), clamp(b * 1.12) })
	local fill = rgb_str(rgb)
	local bottom = rgb_str({ clamp(r * 0.82), clamp(g * 0.82), clamp(b * 0.82) })

	local rows = { string.rep(top, CELL_PX) }
	for _ = 2, CELL_PX - 1 do
		rows[#rows + 1] = string.rep(fill, CELL_PX)
	end
	rows[#rows + 1] = string.rep(bottom, CELL_PX)
	return rows
end

--- Ровный блок CELL_PX x CELL_PX без градиента (для фона поля).
local function make_flat_block(rgb)
	local line = string.rep(rgb_str(rgb), CELL_PX)
	local rows = {}
	for i = 1, CELL_PX do
		rows[i] = line
	end
	return rows
end

--- Таблица блоков: ключ — вид клетки, значение — массив строк (пиксели).
local BLOCKS = {}

local function block_for(key, rgb)
	local block = BLOCKS[key]
	if not block then
		block = make_block(rgb)
		BLOCKS[key] = block
	end
	return block
end

local function prepare_blocks()
	BLOCKS.empty = make_flat_block(RGB_EMPTY)
	BLOCKS.zone = make_flat_block(RGB_ZONE)
	for i = 1, #CELL_RGB do
		block_for("c" .. i, CELL_RGB[i])
	end
end

-- Готовые цвета для узлов детали: обычный, подсветка и приглушённый (нет опоры).
local PIECE_FILL = {}
local PIECE_HI = {}
local PIECE_FILL_DIM = {}
local PIECE_HI_DIM = {}

local function prepare_piece_colors()
	local function vec(r, g, b)
		return vmath.vector4(r / 255, g / 255, b / 255, 1)
	end
	for i = 1, #CELL_RGB do
		local rgb = CELL_RGB[i]
		PIECE_FILL[i] = vec(rgb[1], rgb[2], rgb[3])
		PIECE_HI[i] = vec(
			math.min(255, rgb[1] * 1.18),
			math.min(255, rgb[2] * 1.18),
			math.min(255, rgb[3] * 1.18)
		)
		-- Приглушённый вариант: смешиваем с фоном поля.
		local f = 0.45
		local dr = rgb[1] * f + RGB_EMPTY[1] * (1 - f)
		local dg = rgb[2] * f + RGB_EMPTY[2] * (1 - f)
		local db = rgb[3] * f + RGB_EMPTY[3] * (1 - f)
		PIECE_FILL_DIM[i] = vec(dr, dg, db)
		PIECE_HI_DIM[i] = vec(
			math.min(255, dr * 1.18),
			math.min(255, dg * 1.18),
			math.min(255, db * 1.18)
		)
	end
end

--- Собирает буфер текстуры по текущему состоянию поля.
local function build_buffer(self)
	local rows = {}
	local board = self.board

	local empty_block = BLOCKS.empty
	local zone_block = BLOCKS.zone

	for y = 0, M - 1 do
		local row = board[y]
		-- Строки текстуры, соответствующие этому ряду клеток.
		local buffers = {}
		for i = 0, CELL_PX - 1 do
			buffers[i] = {}
		end

		for x = 0, N - 1 do
			local index = row[x]
			local block
			if index == 0 then
				if x >= ZONE_X and x < ZONE_X + ZONE
					and y >= ZONE_Y and y < ZONE_Y + ZONE then
					block = zone_block
				else
					block = empty_block
				end
			else
				block = BLOCKS["c" .. index] or empty_block
			end
			for i = 0, CELL_PX - 1 do
				local line = buffers[i]
				line[#line + 1] = block[i + 1]
			end
		end

		for i = 0, CELL_PX - 1 do
			rows[#rows + 1] = table.concat(buffers[i])
		end
	end

	return table.concat(rows)
end

local function upload_board(self)
	if not self.board_node then
		return
	end
	local ok = gui.set_texture_data(TEX_ID, TEX_W, TEX_H, "rgb", build_buffer(self), false)
	if not ok then
		print("Не удалось обновить текстуру поля")
	end
end

local function make_box(pos, size, color)
	local node = gui.new_box_node(pos, size)
	gui.set_pivot(node, gui.PIVOT_SW)
	gui.set_adjust_mode(node, gui.ADJUST_STRETCH)
	gui.set_color(node, color)
	return node
end

local function make_label(pos, text, pivot, color)
	local node = gui.new_text_node(pos, text)
	gui.set_font(node, "main")
	gui.set_pivot(node, pivot)
	gui.set_adjust_mode(node, gui.ADJUST_STRETCH)
	gui.set_color(node, color or COLOR_TEXT)
	return node
end

local function lerp(a, b, t)
	return a + (b - a) * t
end

--- Цвет контура для значения опасности 0..1.
local function danger_color(value)
	local from, to, t
	if value < 0.5 then
		from, to, t = COLOR_OK, COLOR_WARN, value / 0.5
	else
		from, to, t = COLOR_WARN, COLOR_BAD, (value - 0.5) / 0.5
	end
	return vmath.vector4(
		lerp(from[1], to[1], t) / 255,
		lerp(from[2], to[2], t) / 255,
		lerp(from[3], to[3], t) / 255,
		1
	)
end

--- Пересчитывает геометрию поля под текущий размер сцены.
--- Поле всегда квадратное, а все его элементы масштабируются вместе с ним.
local function relayout(self)
	local w = gui.get_width()
	local h = gui.get_height()

	local margin_top = h * MARGIN_TOP_R
	local margin_bottom = h * MARGIN_BOTTOM_R
	local margin_side = w * MARGIN_SIDE_R

	local avail_w = w - margin_side * 2
	local avail_h = h - margin_top - margin_bottom
	local size = math.max(64, math.min(avail_w, avail_h))

	self.cell = size / N
	self.board_size = size
	self.origin_x = (w - size) / 2
	self.origin_y = margin_bottom + math.max(0, (avail_h - size) / 2)

	self.margin_top = margin_top
	self.margin_bottom = margin_bottom
	-- Толщины линий контура пропорциональны клетке поля.
	self.frame_t = math.max(1.5, self.cell * FRAME_T_R)
	self.frame_glow_t = math.max(self.frame_t, self.cell * FRAME_GLOW_T_R)

	self.scene_w = w
	self.scene_h = h
end

local function build_board_node(self)
	if self.board_node then
		gui.delete_node(self.board_node)
	end

	if not self.texture_ready then
		local ok = gui.new_texture(TEX_ID, TEX_W, TEX_H, "rgb", string.rep(string.char(0), TEX_W * TEX_H * 3))
		if not ok then
			print("Не удалось создать текстуру поля")
			return
		end
		self.texture_ready = true
	end

	self.board_node = make_box(
		vmath.vector3(self.origin_x, self.origin_y, 0.05),
		vmath.vector3(self.board_size, self.board_size, 0),
		vmath.vector4(1, 1, 1, 1)
	)
	gui.set_texture(self.board_node, TEX_ID)
end

--- Удаляет узлы контура зоны.
local function clear_frame(self)
	if self.frame then
		for i = 1, #self.frame do
			gui.delete_node(self.frame[i])
		end
		self.frame = nil
	end
end

--- Создаёт подложку и контур центральной зоны появления фигур.
local function build_frame(self)
	clear_frame(self)

	local zx = self.origin_x + ZONE_X * self.cell
	local zy = self.origin_y + ZONE_Y * self.cell
	local zs = ZONE * self.cell

	local t = self.frame_t
	local g = self.frame_glow_t
	local color = danger_color(self.danger or 0)
	local glow = vmath.vector4(color.x, color.y, color.z, FRAME_GLOW_ALPHA)

	local bars = {
		{ zx - t / 2, zy - t / 2, zs + t, t }, -- нижняя
		{ zx - t / 2, zy + zs - t / 2, zs + t, t }, -- верхняя
		{ zx - t / 2, zy - t / 2, t, zs + t }, -- левая
		{ zx + zs - t / 2, zy - t / 2, t, zs + t }, -- правая
	}

	local glows = {
		{ zx - g / 2, zy - g / 2, zs + g, g },
		{ zx - g / 2, zy + zs - g / 2, zs + g, g },
		{ zx - g / 2, zy - g / 2, g, zs + g },
		{ zx + zs - g / 2, zy - g / 2, g, zs + g },
	}

	local nodes = {}
	for i = 1, #glows do
		local b = glows[i]
		nodes[#nodes + 1] = make_box(vmath.vector3(b[1], b[2], 0.25), vmath.vector3(b[3], b[4], 0), glow)
	end
	for i = 1, #bars do
		local b = bars[i]
		nodes[#nodes + 1] = make_box(vmath.vector3(b[1], b[2], 0.3), vmath.vector3(b[3], b[4], 0), color)
	end

	self.frame = nodes
end

--- Перекрашивает контур зоны под текущее значение опасности.
local function update_frame(self)
	if not self.frame then
		return
	end
	local color = danger_color(self.danger or 0)
	local glow = vmath.vector4(color.x, color.y, color.z, FRAME_GLOW_ALPHA)
	-- [1..4] — свечение, [5..8] — сам контур.
	for i = 1, 4 do
		gui.set_color(self.frame[i], glow)
	end
	for i = 5, #self.frame do
		gui.set_color(self.frame[i], color)
	end
end

--- Удаляет узлы текущей детали.
local function clear_piece_nodes(self)
	if self.piece_nodes then
		for i = 1, #self.piece_nodes do
			local n = self.piece_nodes[i]
			gui.delete_node(n.fill)
			gui.delete_node(n.hi)
		end
		self.piece_nodes = nil
	end
end

--- Ставит узлы детали в пиксельную позицию (левый нижний угол её bbox).
local function position_piece_nodes(self, base_x, base_y)
	if not self.piece_nodes then
		return
	end
	local cell = self.cell
	local hi_h = math.max(1, cell * PIECE_HI_R)
	for i = 1, #self.piece_nodes do
		local n = self.piece_nodes[i]
		local x = base_x + n.cx * cell
		local y = base_y + n.cy * cell
		gui.set_position(n.fill, vmath.vector3(x, y, 0.5))
		gui.set_position(n.hi, vmath.vector3(x, y + cell - hi_h, 0.52))
	end
end

--- Ставит узлы детали в позицию по клеткам.
local function snap_piece_nodes(self)
	local piece = self.piece
	if not piece then
		return
	end
	position_piece_nodes(
		self,
		self.origin_x + piece.x * self.cell,
		self.origin_y + piece.y * self.cell
	)
end

--- Перекрашивает деталь: обычный цвет, если отпускание оставит её на поле,
--- иначе — приглушённый (визуальная подсказка «вернётся в центр»).
local function color_piece_nodes(self, supported)
	local piece = self.piece
	if not piece or not self.piece_nodes then
		return
	end
	local fill_set = supported and PIECE_FILL or PIECE_FILL_DIM
	local hi_set = supported and PIECE_HI or PIECE_HI_DIM
	local c = piece.color
	if not fill_set[c] then
		c = 1
	end
	for i = 1, #self.piece_nodes do
		gui.set_color(self.piece_nodes[i].fill, fill_set[c])
		gui.set_color(self.piece_nodes[i].hi, hi_set[c])
	end
end

--- Пересоздаёт узлы детали под её текущую форму.
local function build_piece_nodes(self)
	clear_piece_nodes(self)
	local piece = self.piece
	if not piece then
		return
	end

	local cell = self.cell
	local hi_h = math.max(1, cell * PIECE_HI_R)
	local nodes = {}
	for i = 1, #piece.cells do
		local fill = make_box(
			vmath.vector3(0, 0, 0.5),
			vmath.vector3(cell, cell, 0),
			PIECE_FILL[piece.color] or PIECE_FILL[1]
		)
		local hi = make_box(
			vmath.vector3(0, 0, 0.52),
			vmath.vector3(cell, hi_h, 0),
			PIECE_HI[piece.color] or PIECE_HI[1]
		)
		nodes[i] = {
			fill = fill,
			hi = hi,
			cx = piece.cells[i][1],
			cy = piece.cells[i][2],
		}
	end
	self.piece_nodes = nodes
	snap_piece_nodes(self)
end

--- HUD: позиции в долях размера сцены, шрифт масштабируется вместе с полем.
local function build_hud(self)
	local w = self.scene_w
	local h = self.scene_h

	if self.title then
		gui.delete_node(self.title)
		gui.delete_node(self.score)
		gui.delete_node(self.hint)
		gui.delete_node(self.status)
	end

	-- Размер шрифта пропорционален стороне поля (22 px при поле ~420 px).
	local scale = math.max(0.6, self.board_size / 420)

	self.title = make_label(vmath.vector3(w / 2, h - h * 0.065, 0.1), "КВАДРОК", gui.PIVOT_N, COLOR_TEXT)
	self.score = make_label(vmath.vector3(w / 2, h - h * 0.11, 0.1), "", gui.PIVOT_N, COLOR_TEXT_DIM)
	self.status = make_label(vmath.vector3(w / 2, h * 0.095, 0.1), "", gui.PIVOT_S, COLOR_TEXT_DIM)
	-- Сохраняем актуальную подсказку при пересоздании узла (например, после resize).
	self.hint = make_label(
		vmath.vector3(w / 2, h * 0.055, 0.1),
		self.hint_text or HINT_PLAY,
		gui.PIVOT_S,
		COLOR_TEXT
	)

	local labels = { self.title, self.score, self.status, self.hint }
	for i = 1, #labels do
		gui.set_scale(labels[i], vmath.vector3(scale, scale, 1))
	end
end

local function set_hint(self, text)
	if self.hint_text == text then
		return
	end
	self.hint_text = text
	gui.set_text(self.hint, text)
end

local function update_hud(self)
	if self.points ~= self.shown_points then
		self.shown_points = self.points
		gui.set_text(self.score, "Очки: " .. tostring(self.points))
	end

	if self.state == "gameover" then
		return
	end

	local pct = math.floor((self.danger or 0) * 100 + 0.5)
	if pct ~= self.shown_pct then
		self.shown_pct = pct
		gui.set_text(self.status, "Угроза: " .. tostring(pct) .. "%")
	end
end

local function refresh(self)
	if self.state ~= "gameover" then
		self.danger_target = game.danger(self.board)
	end
	upload_board(self)
	-- Перекрашиваем контур сразу, чтобы после рестарта и ресайза цвет
	-- соответствовал текущему состоянию поля.
	update_frame(self)
	update_hud(self)
end

--- Можно ли оставить деталь в текущей позиции:
--- все клетки свободны, зона появления не задета и есть опора
--- (граница поля или ранее поставленная деталь).
local function drop_supported(self)
	local piece = self.piece
	if not piece then
		return false
	end
	return game.can_drop(self.board, piece.cells, piece.x, piece.y)
		and game.has_support(self.board, piece.cells, piece.x, piece.y)
end

--- Завершает партию: фиксируем причину и показываем подсказку рестарта.
local function game_over(self, reason)
	self.state = "gameover"
	self.piece = nil
	self.drag = nil
	self.return_anim = nil
	clear_piece_nodes(self)
	self.danger_target = 1
	self.danger = 1
	set_hint(self, HINT_GAMEOVER)
	gui.set_text(self.status, reason)
	refresh(self)
end

--- Появление новой фигуры в центре зоны.
local function spawn(self)
	local piece = game.random_piece()
	local x, y = game.spawn_pos(piece)

	if not game.can_place(self.board, piece.cells, x, y) then
		game_over(self, "Зона занята")
		return
	end

	-- Если деталь некуда поставить с опорой, партия исчерпана.
	if not game.has_any_drop(self.board, piece) then
		game_over(self, "Нет места для детали")
		return
	end

	piece.x = x
	piece.y = y
	self.piece = piece
	self.drag = nil
	self.return_anim = nil
	build_piece_nodes(self)
	-- В центре у детали ещё нет опоры, но приглушение включается только
	-- во время перетаскивания, поэтому подсвечиваем её обычным цветом.
	color_piece_nodes(self, true)
	set_hint(self, HINT_PLAY)
	refresh(self)
end

--- Отпускание детали: остаётся на поле только при наличии опоры.
--- Иначе улетает обратно в центр зоны появления.
local function release_piece(self)
	local piece = self.piece
	if not piece then
		return
	end

	if drop_supported(self) then
		game.place(self.board, piece.cells, piece.x, piece.y, piece.color)
		self.points = self.points + #piece.cells
		self.piece = nil
		clear_piece_nodes(self)
		refresh(self)
		spawn(self)
		return
	end

	-- Возврат в центр: плавно, но целевая позиция — клетки зоны появления.
	local sx, sy = game.spawn_pos(piece)
	local from_x = self.origin_x + piece.x * self.cell
	local from_y = self.origin_y + piece.y * self.cell
	local to_x = self.origin_x + sx * self.cell
	local to_y = self.origin_y + sy * self.cell

	color_piece_nodes(self, false)
	set_hint(self, HINT_DRAG_BAD)

	if math.abs(from_x - to_x) < 0.5 and math.abs(from_y - to_y) < 0.5 then
		piece.x = sx
		piece.y = sy
		snap_piece_nodes(self)
		color_piece_nodes(self, true)
		set_hint(self, HINT_PLAY)
		return
	end

	self.return_anim = {
		t = 0,
		dur = RETURN_DURATION,
		from_x = from_x,
		from_y = from_y,
		to_x = to_x,
		to_y = to_y,
		sx = sx,
		sy = sy,
	}
end

local function restart(self)
	self.board = game.new_board()
	self.points = 0
	self.danger = 0
	self.danger_target = 0
	self.shown_pct = nil
	self.shown_points = nil
	self.state = "play"
	self.drag = nil
	self.return_anim = nil
	self.piece = nil
	clear_piece_nodes(self)
	gui.set_text(self.status, "")
	-- Сразу возвращаем контуру зелёный цвет (он мог остаться красным).
	update_frame(self)
	update_hud(self)
	spawn(self)
end

function init(self)
	self.points = 0
	self.state = "play"
	self.board = game.new_board()
	self.danger = 0
	self.danger_target = 0
	self.shown_pct = nil
	self.shown_points = nil
	self.drag = nil
	self.return_anim = nil

	prepare_blocks()
	prepare_piece_colors()
	relayout(self)
	build_board_node(self)
	build_hud(self)
	build_frame(self)
	spawn(self)

	msg.post(".", "acquire_input_focus")
end

function update(self, dt)
	-- Анимация возврата детали в центр зоны.
	local anim = self.return_anim
	if anim then
		anim.t = anim.t + dt
		local k = anim.t / anim.dur
		if k > 1 then k = 1 end
		-- Плавное замедление в конце.
		local e = 1 - (1 - k) * (1 - k) * (1 - k)
		position_piece_nodes(
			self,
			lerp(anim.from_x, anim.to_x, e),
			lerp(anim.from_y, anim.to_y, e)
		)
		if k >= 1 then
			self.return_anim = nil
			local piece = self.piece
			if piece then
				piece.x = anim.sx
				piece.y = anim.sy
				snap_piece_nodes(self)
				color_piece_nodes(self, true)
			end
			if self.state ~= "gameover" then
				set_hint(self, HINT_PLAY)
			end
		end
	end

	local target = self.danger_target or 0

	-- Плавное приближение к целевому значению.
	local step = math.min(1, dt * 3)
	local next_value = self.danger + (target - self.danger) * step
	if math.abs(next_value - self.danger) < 0.0005 then
		next_value = target
	end

	if next_value ~= self.danger then
		self.danger = next_value
		update_frame(self)
		update_hud(self)
	end
end

--- Клетка поля под точкой касания (дробные координаты в клетках).
local function board_point(self, x, y)
	return (x - self.origin_x) / self.cell, (y - self.origin_y) / self.cell
end

--- Идентификатор касания: в новых версиях Defold он есть и в action.id,
--- и в записи action.touch; поддерживаем оба варианта.
local function touch_id(action)
	if action.id ~= nil then
		return action.id
	end
	local entry = action.touch and action.touch[1]
	return entry and entry.id or nil
end

--- Координаты указателя: сначала плоские поля action, затем запись touch.
local function touch_xy(action)
	if action.x ~= nil and action.y ~= nil then
		return action.x, action.y
	end
	local entry = action.touch and action.touch[1]
	if entry and entry.x ~= nil and entry.y ~= nil then
		return entry.x, entry.y
	end
	return nil, nil
end

--- Есть ли клетка (cx, cy) в составе детали.
local function piece_has_cell(piece, cx, cy)
	for i = 1, #piece.cells do
		if piece.x + piece.cells[i][1] == cx and piece.y + piece.cells[i][2] == cy then
			return true
		end
	end
	return false
end

function on_input(self, action_id, action)
	if action_id ~= hash("touch") then
		return false
	end

	-- Пока деталь летит в центр, ввод игнорируем.
	if self.return_anim then
		return true
	end

	if action.pressed then
		if self.state == "gameover" then
			restart(self)
			return true
		end
		local piece = self.piece
		if not piece or self.drag then
			return true
		end

		local ax, ay = touch_xy(action)
		if ax == nil then
			return true
		end

		local bx, by = board_point(self, ax, ay)
		local cx = math.floor(bx)
		local cy = math.floor(by)
		if not piece_has_cell(piece, cx, cy) then
			return true
		end

		-- Захват: запоминаем дробное смещение точки внутри детали, чтобы она
		-- не «прыгала» при первом же сдвиге.
		self.drag = {
			id = touch_id(action),
			off_x = bx - piece.x,
			off_y = by - piece.y,
		}
		color_piece_nodes(self, drop_supported(self))
		set_hint(self, drop_supported(self) and HINT_DRAG_OK or HINT_DRAG_BAD)
		return true
	end

	if not self.drag then
		return true
	end

	if self.drag.id ~= nil and touch_id(action) ~= self.drag.id then
		return true
	end

	-- Defold присылает экшен каждый кадр, пока палец на экране: отдельного
	-- признака `moved` у touch-экшена нет, поэтому двигаем деталь по
	-- актуальным координатам указателя.
	local ax, ay = touch_xy(action)
	if ax ~= nil then
		local bx, by = board_point(self, ax, ay)
		-- Квантизация: деталь двигается по клеткам, оставаясь под пальцем.
		local want_x = math.floor(bx - self.drag.off_x + 0.5)
		local want_y = math.floor(by - self.drag.off_y + 0.5)
		local piece = self.piece
		if piece then
			want_x, want_y = game.clamp_pos(piece, want_x, want_y)

			-- Скольжение вдоль препятствий: если целевая клетка занята, деталь
			-- продолжает двигаться по свободной оси, а не застревает.
			local px, py = piece.x, piece.y
			if game.can_place(self.board, piece.cells, want_x, want_y) then
				px, py = want_x, want_y
			elseif game.can_place(self.board, piece.cells, want_x, py) then
				px = want_x
			elseif game.can_place(self.board, piece.cells, px, want_y) then
				py = want_y
			end

			if px ~= piece.x or py ~= piece.y then
				piece.x = px
				piece.y = py
				snap_piece_nodes(self)
				local ok = drop_supported(self)
				color_piece_nodes(self, ok)
				set_hint(self, ok and HINT_DRAG_OK or HINT_DRAG_BAD)
			end
		end
	end

	if action.released then
		self.drag = nil
		release_piece(self)
	end

	return true
end

function on_message(self, message_id, message, sender)
	if message_id == hash("window_resized") then
		-- Ресайз во время возврата: сразу доводим деталь до центра,
		-- чтобы пиксельные координаты анимации не разъехались с новой сеткой.
		if self.return_anim and self.piece then
			local piece = self.piece
			piece.x = self.return_anim.sx
			piece.y = self.return_anim.sy
			self.return_anim = nil
			self.drag = nil
			if self.state ~= "gameover" then
				set_hint(self, HINT_PLAY)
			end
		end
		relayout(self)
		build_board_node(self)
		build_hud(self)
		build_frame(self)
		build_piece_nodes(self)
		refresh(self)
	elseif message_id == hash("restart") then
		restart(self)
	end
end
