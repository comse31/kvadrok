local game = require("main.game")
local progress = require("main.progress")

-- Отступы интерфейса — в долях от размера сцены, чтобы пропорции не зависели
-- от разрешения и масштаба экрана.
local MARGIN_TOP_R = 0.165   -- 132 px при высоте 800
local MARGIN_BOTTOM_R = 0.145 -- 116 px при высоте 800
local MARGIN_SIDE_R = 0.048  -- 20 px при ширине 420

-- Разрешение одной клетки в текстуре поля.
local CELL_PX = 8

-- Эталонное разрешение сцены из game.project. Вся геометрия задаётся в этих
-- единицах, а движок при ADJUST_FIT масштабирует её единым коэффициентом по
-- меньшей стороне окна. Поэтому при изменении размера окна пропорции поля и
-- интерфейса не меняются, а свободное место остаётся полями по краям.
local BASE_W = 420
local BASE_H = 800

local TEX_ID_PREFIX = "board_tx_"

-- Контур центральной зоны — линия толщиной ровно 1 игровой пиксель, то есть
-- 1 пиксель текстуры поля (1/8 клетки). Она лежит на пиксельной сетке текстуры
-- и не «расплывается» при масштабировании, оставаясь тонкой и аккуратной.
local FRAME_T = 1
local FRAME_ALPHA = 0.72

-- Единственный слабый ореол снаружи контура (радиус в игровых пикселях).
-- Одно кольцо вместо нескольких ступеней: свечение читается как мягкая тень,
-- без видимых прямоугольных полос и без двойной прозрачности в углах.
local FRAME_GLOWS = {
	{ t = 3, alpha = 0.055 },
}

-- Длительность анимации возврата детали в центр (секунды).
local RETURN_DURATION = 0.22

-- Анимация уборки кубиков: каждый кубик летит в центр поля и растворяется.
-- Кубики запускаются каскадом (слева направо для ряда, сверху вниз для
-- столбца), поэтому задержка между ними ограничена сверху и по сумме.
local CLEAR_CUBE_DURATION = 0.3
local CLEAR_STAGGER_MAX = 0.06
local CLEAR_STAGGER_TOTAL = 0.9

-- Анимация сдвига оставшихся кубиков к ближайшей стороне поля. Начинается
-- после исчезновения убранных кубиков.
local MOVE_CUBE_DURATION = 0.2

-- Высота подсветки верхней грани клетки детали (доля клетки).
local PIECE_HI_R = 0.18

-- Палитра клеток (RGB 0..255).
local CELL_RGB = {
	{ 61, 199, 240 },
	{ 250, 209, 69 },
	{ 184, 117, 242 },
	{ 92, 219, 133 },
	{ 245, 112, 112 },
	{ 97, 148, 250 },
	{ 250, 158, 71 },
}

-- Цвет фона поля и пустых клеток (сетка не рисуется).
local RGB_EMPTY = { 21, 27, 39 }
-- Чуть более светлый фон клеток внутри зоны появления.
local RGB_ZONE = { 28, 36, 52 }

-- Цвета контура: зелёный -> жёлтый -> красный.
local COLOR_OK = { 62, 226, 124 }
local COLOR_WARN = { 246, 212, 66 }
local COLOR_BAD = { 246, 62, 62 }

local COLOR_TEXT = vmath.vector4(0.92, 0.95, 1.0, 1.0)
local COLOR_TEXT_DIM = vmath.vector4(0.60, 0.67, 0.80, 1.0)

local HINT_PLAY = "Тащи деталь к краю или к фигуре"
local HINT_DRAG_OK = "Отпусти — деталь останется"
local HINT_DRAG_BAD = "Нет опоры — вернётся в центр"
local HINT_CLEAR = "Ряд собран — кубики убраны"

-- Таблички окончания партии. Заголовки разбиты на две строки, чтобы длинные
-- фразы гарантированно помещались в плашку на узких экранах.
local LOSE_TITLE = "Не беда,\nпопробуй снова"
local LOSE_HINT = "Тап — сыграть ещё раз"
local WIN_TITLE = "Получилось!\nНу тогда усложняем"
local WIN_HINT = "Тап — следующее поле"
local WIN_MAX_TITLE = "Получилось!\nЭто максимум"
local WIN_MAX_HINT = "Тап — сыграть ещё раз"

local function rgb_str(rgb)
	return string.char(rgb[1], rgb[2], rgb[3])
end

--- Собирает блок CELL_PX x CELL_PX без рамки: мягкий объём по вертикали.
local function make_block(rgb)
	local r, g, b = rgb[1], rgb[2], rgb[3]
	local function clamp(v)
		if v < 0 then return 0 elseif v > 255 then return 255 end
		return math.floor(v)
	end

	local top = rgb_str({ clamp(r * 1.12), clamp(g * 1.12), clamp(b * 1.12) })
	local fill = rgb_str(rgb)
	local bottom = rgb_str({ clamp(r * 0.82), clamp(g * 0.82), clamp(b * 0.82) })

	local rows = { string.rep(top, CELL_PX) }
	for _ = 2, CELL_PX - 1 do
		rows[#rows + 1] = string.rep(fill, CELL_PX)
	end
	rows[#rows + 1] = string.rep(bottom, CELL_PX)
	return rows
end

--- Ровный блок CELL_PX x CELL_PX без градиента (для фона поля).
local function make_flat_block(rgb)
	local line = string.rep(rgb_str(rgb), CELL_PX)
	local rows = {}
	for i = 1, CELL_PX do
		rows[i] = line
	end
	return rows
end

--- Таблица блоков: ключ — вид клетки, значение — массив строк (пиксели).
local BLOCKS = {}

local function block_for(key, rgb)
	local block = BLOCKS[key]
	if not block then
		block = make_block(rgb)
		BLOCKS[key] = block
	end
	return block
end

local function prepare_blocks()
	BLOCKS.empty = make_flat_block(RGB_EMPTY)
	BLOCKS.zone = make_flat_block(RGB_ZONE)
	for i = 1, #CELL_RGB do
		block_for("c" .. i, CELL_RGB[i])
	end
end

-- Готовые цвета для узлов детали: обычный, подсветка и приглушённый (нет опоры).
local PIECE_FILL = {}
local PIECE_HI = {}
local PIECE_FILL_DIM = {}
local PIECE_HI_DIM = {}

local function prepare_piece_colors()
	local function vec(r, g, b)
		return vmath.vector4(r / 255, g / 255, b / 255, 1)
	end
	for i = 1, #CELL_RGB do
		local rgb = CELL_RGB[i]
		PIECE_FILL[i] = vec(rgb[1], rgb[2], rgb[3])
		PIECE_HI[i] = vec(
			math.min(255, rgb[1] * 1.18),
			math.min(255, rgb[2] * 1.18),
			math.min(255, rgb[3] * 1.18)
		)
		-- Приглушённый вариант: смешиваем с фоном поля.
		local f = 0.45
		local dr = rgb[1] * f + RGB_EMPTY[1] * (1 - f)
		local dg = rgb[2] * f + RGB_EMPTY[2] * (1 - f)
		local db = rgb[3] * f + RGB_EMPTY[3] * (1 - f)
		PIECE_FILL_DIM[i] = vec(dr, dg, db)
		PIECE_HI_DIM[i] = vec(
			math.min(255, dr * 1.18),
			math.min(255, dg * 1.18),
			math.min(255, db * 1.18)
		)
	end
end

--- Собирает буфер текстуры по текущему состоянию поля.
--- В логике ряд 0 — нижний, а строки текстуры идут сверху вниз, поэтому
--- ряды перебираются в обратном порядке: иначе поле отрисовывается зеркально.
--- Размер поля берётся из модуля логики (game.W/game.H), потому что он
--- меняется при переходе на следующий уровень.
local function build_buffer(self)
	local rows = {}
	-- Во время анимации сдвига поле рисуется в промежуточном состоянии:
	-- линии уже убраны, но оставшиеся кубики ещё не сдвинуты. Их сдвиг
	-- показывают отдельные узлы.
	local board = self.board_render or self.board

	local n = game.W
	local m = game.H
	local zone = game.ZONE
	local zone_x = game.ZONE_X
	local zone_y = game.ZONE_Y

	local empty_block = BLOCKS.empty
	local zone_block = BLOCKS.zone

	for y = m - 1, 0, -1 do
		local row = board[y]
		-- Строки текстуры, соответствующие этому ряду клеток.
		local buffers = {}
		for i = 0, CELL_PX - 1 do
			buffers[i] = {}
		end

		for x = 0, n - 1 do
			local index = row[x]
			local block
			if index == 0 then
				if x >= zone_x and x < zone_x + zone
					and y >= zone_y and y < zone_y + zone then
					block = zone_block
				else
					block = empty_block
				end
			else
				block = BLOCKS["c" .. index] or empty_block
			end
			for i = 0, CELL_PX - 1 do
				local line = buffers[i]
				line[#line + 1] = block[i + 1]
			end
		end

		for i = 0, CELL_PX - 1 do
			rows[#rows + 1] = table.concat(buffers[i])
		end
	end

	return table.concat(rows)
end

local function upload_board(self)
	if not self.board_node or not self.tex_id then
		return
	end
	local ok = gui.set_texture_data(self.tex_id, self.tex_w, self.tex_h, "rgb", build_buffer(self), false)
	if not ok then
		print("Не удалось обновить текстуру поля")
	end
end

--- Узлы используют ADJUST_FIT, чтобы движок масштабировал их равномерно по обеим
--- осям: при изменении размера окна пропорции поля и интерфейса не меняются.
local function make_box(pos, size, color)
	local node = gui.new_box_node(pos, size)
	gui.set_pivot(node, gui.PIVOT_SW)
	gui.set_adjust_mode(node, gui.ADJUST_FIT)
	gui.set_color(node, color)
	return node
end

local function make_label(pos, text, pivot, color)
	local node = gui.new_text_node(pos, text)
	gui.set_font(node, "main")
	gui.set_pivot(node, pivot)
	gui.set_adjust_mode(node, gui.ADJUST_FIT)
	gui.set_color(node, color or COLOR_TEXT)
	return node
end

local function lerp(a, b, t)
	return a + (b - a) * t
end

--- Цвет контура для значения опасности 0..1.
local function danger_color(value)
	local from, to, t
	if value < 0.5 then
		from, to, t = COLOR_OK, COLOR_WARN, value / 0.5
	else
		from, to, t = COLOR_WARN, COLOR_BAD, (value - 0.5) / 0.5
	end
	return vmath.vector4(
		lerp(from[1], to[1], t) / 255,
		lerp(from[2], to[2], t) / 255,
		lerp(from[3], to[3], t) / 255,
		1
	)
end

--- Пересчитывает геометрию поля.
--- Вся геометрия задаётся в эталонных единицах сцены (BASE_W x BASE_H) и не
--- зависит от фактического размера окна: узлы используют gui.ADJUST_FIT, поэтому
--- движок масштабирует их единым коэффициентом. Пропорции поля и интерфейса
--- при изменении размера окна остаются неизменными.
--- Также запоминается фактический размер окна и параметры вписывания сцены,
--- чтобы корректно переводить координаты касаний в координаты сцены.
local function relayout(self)
	local margin_top = BASE_H * MARGIN_TOP_R
	local margin_bottom = BASE_H * MARGIN_BOTTOM_R
	local margin_side = BASE_W * MARGIN_SIDE_R

	local avail_w = BASE_W - margin_side * 2
	local avail_h = BASE_H - margin_top - margin_bottom
	local size = math.min(avail_w, avail_h)
	if size < 64 then
		size = 64
	end

	-- Сторона клетки зависит от текущего размера поля: при росте уровня
	-- клетки становятся мельче, а поле занимает ту же площадь экрана.
	self.cell = size / game.W
	self.board_size = size
	self.origin_x = (BASE_W - size) * 0.5
	self.origin_y = margin_bottom + math.max(0, (avail_h - size) / 2)

	self.margin_top = margin_top
	self.margin_bottom = margin_bottom
	-- 1 игровой пиксель = 1 пиксель текстуры поля; на этой сетке лежит контур.
	self.gp = self.cell / CELL_PX

	-- Эталонные размеры сцены: HUD считает координаты в этих единицах.
	self.scene_w = BASE_W
	self.scene_h = BASE_H
end

--- Кэш текстур поля по размеру: при росте уровня у поля другая сторона
--- в клетках, поэтому нужен отдельный буфер другой величины. Текстура для
--- каждого размера создаётся один раз и переиспользуется.
local TEXTURES = {}

--- Возвращает идентификатор и размеры текстуры для поля текущего уровня,
--- создавая её при первом обращении.
local function board_texture()
	local n = game.W
	local m = game.H
	local tex_w = n * CELL_PX
	local tex_h = m * CELL_PX
	local key = n .. "x" .. m

	local entry = TEXTURES[key]
	if not entry then
		local id = TEX_ID_PREFIX .. n .. "x" .. m
		local ok = gui.new_texture(id, tex_w, tex_h, "rgb", string.rep(string.char(0), tex_w * tex_h * 3))
		if not ok then
			print("Не удалось создать текстуру поля")
			return nil
		end
		entry = { id = id, w = tex_w, h = tex_h }
		TEXTURES[key] = entry
	end
	return entry
end

local function build_board_node(self)
	if self.board_node then
		gui.delete_node(self.board_node)
	end

	local tex = board_texture()
	if not tex then
		return
	end
	self.tex_id = tex.id
	self.tex_w = tex.w
	self.tex_h = tex.h

	self.board_node = make_box(
		vmath.vector3(self.origin_x, self.origin_y, 0.05),
		vmath.vector3(self.board_size, self.board_size, 0),
		vmath.vector4(1, 1, 1, 1)
	)
	gui.set_texture(self.board_node, self.tex_id)
end

--- Удаляет узлы контура зоны.
local function clear_frame(self)
	if self.frame then
		for i = 1, #self.frame do
			local group = self.frame[i]
			for j = 1, #group.nodes do
				gui.delete_node(group.nodes[j])
			end
		end
		self.frame = nil
	end
end

--- Создаёт контур центральной зоны появления фигур.
--- Границы зоны лежат на пиксельной сетке текстуры поля: толщина линии —
--- ровно 1 игровой пиксель, поэтому она остаётся тонкой при любом масштабе.
local function build_frame(self)
	clear_frame(self)

	local gp = self.gp or (self.cell / CELL_PX)
	local x = self.origin_x + game.ZONE_X * self.cell
	local y = self.origin_y + game.ZONE_Y * self.cell
	local w = game.ZONE * self.cell
	local h = w
	local color = danger_color(self.danger or 0)
	local groups = {}

	-- Ореолы: кольца снаружи зоны, от внешнего к внутреннему.
	for i = #FRAME_GLOWS, 1, -1 do
		local glow = FRAME_GLOWS[i]
		local inner_r = ((i > 1) and FRAME_GLOWS[i - 1].t or 0) * gp
		local outer_r = glow.t * gp
		local band = outer_r - inner_r
		local bars = {
			{ x - outer_r, y - outer_r, w + outer_r * 2, band }, -- нижняя
			{ x - outer_r, y + h + inner_r, w + outer_r * 2, band }, -- верхняя
			{ x - outer_r, y - inner_r, band, h + inner_r * 2 }, -- левая
			{ x + w + inner_r, y - inner_r, band, h + inner_r * 2 }, -- правая
		}
		local c = vmath.vector4(color.x, color.y, color.z, glow.alpha)
		local nodes = {}
		for j = 1, #bars do
			local b = bars[j]
			nodes[j] = make_box(vmath.vector3(b[1], b[2], 0.2), vmath.vector3(b[3], b[4], 0), c)
		end
		groups[#groups + 1] = { alpha = glow.alpha, nodes = nodes }
	end

	-- Сама линия: ровно 1 игровой пиксель по внутреннему краю зоны.
	-- Углы закрыты горизонтальными полосами, поэтому швов нет, а ореолы
	-- начинаются снаружи и не накладываются на линию.
	local t = FRAME_T * gp
	local bars = {
		{ x, y, w, t }, -- нижняя
		{ x, y + h - t, w, t }, -- верхняя
		{ x, y + t, t, h - t * 2 }, -- левая
		{ x + w - t, y + t, t, h - t * 2 }, -- правая
	}
	local line_color = vmath.vector4(color.x, color.y, color.z, FRAME_ALPHA)
	local nodes = {}
	for i = 1, #bars do
		local b = bars[i]
		nodes[i] = make_box(vmath.vector3(b[1], b[2], 0.3), vmath.vector3(b[3], b[4], 0), line_color)
	end
	groups[#groups + 1] = { alpha = FRAME_ALPHA, nodes = nodes }

	self.frame = groups
end

--- Перекрашивает контур зоны под текущее значение опасности.
local function update_frame(self)
	if not self.frame then
		return
	end
	local color = danger_color(self.danger or 0)
	for i = 1, #self.frame do
		local group = self.frame[i]
		local c = vmath.vector4(color.x, color.y, color.z, group.alpha)
		for j = 1, #group.nodes do
			gui.set_color(group.nodes[j], c)
		end
	end
end

--- Удаляет узлы текущей детали.
local function clear_piece_nodes(self)
	if self.piece_nodes then
		for i = 1, #self.piece_nodes do
			local n = self.piece_nodes[i]
			gui.delete_node(n.fill)
			gui.delete_node(n.hi)
		end
		self.piece_nodes = nil
	end
end

--- Ставит узлы детали в пиксельную позицию (левый нижний угол её bbox).
local function position_piece_nodes(self, base_x, base_y)
	if not self.piece_nodes then
		return
	end
	local cell = self.cell
	local hi_h = math.max(1, cell * PIECE_HI_R)
	for i = 1, #self.piece_nodes do
		local n = self.piece_nodes[i]
		local x = base_x + n.cx * cell
		local y = base_y + n.cy * cell
		gui.set_position(n.fill, vmath.vector3(x, y, 0.5))
		gui.set_position(n.hi, vmath.vector3(x, y + cell - hi_h, 0.52))
	end
end

--- Ставит узлы детали в позицию по клеткам.
local function snap_piece_nodes(self)
	local piece = self.piece
	if not piece then
		return
	end
	position_piece_nodes(
		self,
		self.origin_x + piece.x * self.cell,
		self.origin_y + piece.y * self.cell
	)
end

--- Перекрашивает деталь: обычный цвет, если отпускание оставит её на поле,
--- иначе — приглушённый (визуальная подсказка «вернётся в центр»).
local function color_piece_nodes(self, supported)
	local piece = self.piece
	if not piece or not self.piece_nodes then
		return
	end
	local fill_set = supported and PIECE_FILL or PIECE_FILL_DIM
	local hi_set = supported and PIECE_HI or PIECE_HI_DIM
	local c = piece.color
	if not fill_set[c] then
		c = 1
	end
	for i = 1, #self.piece_nodes do
		gui.set_color(self.piece_nodes[i].fill, fill_set[c])
		gui.set_color(self.piece_nodes[i].hi, hi_set[c])
	end
end

--- Удаляет узлы летящих в центр кубиков.
local function clear_fly_nodes(self)
	if self.clear_anim then
		for i = 1, #self.clear_anim.cubes do
			local c = self.clear_anim.cubes[i]
			gui.delete_node(c.fill)
			gui.delete_node(c.hi)
		end
		self.clear_anim = nil
	end
end

--- Запускает каскадную уборку кубиков: каждый кубик по очереди (слева
--- направо для ряда, сверху вниз для столбца) улетает в центр поля и
--- растворяется там. После неё запускается сдвиг оставшихся кубиков.
local function start_clear_anim(self, cells, moves)
	clear_fly_nodes(self)

	local cell = self.cell
	local hi_h = math.max(1, cell * PIECE_HI_R)

	local max_order = 0
	for i = 1, #cells do
		if cells[i].order > max_order then max_order = cells[i].order end
	end

	-- Задержка каскада: не больше CLEAR_STAGGER_MAX на кубик и не больше
	-- CLEAR_STAGGER_TOTAL на всю линию, чтобы анимация не затягивалась.
	local stagger = 0
	if max_order > 0 then
		stagger = math.min(CLEAR_STAGGER_MAX, CLEAR_STAGGER_TOTAL / max_order)
	end

	local to_x = self.origin_x + self.board_size * 0.5
	local to_y = self.origin_y + self.board_size * 0.5

	local cubes = {}
	local last = 0
	for i = 1, #cells do
		local c = cells[i]
		-- Кубик летит из центра своей клетки; узлы получают PIVOT_CENTER,
		-- чтобы уменьшение происходило вокруг центра.
		local base_x = self.origin_x + (c.x + 0.5) * cell
		local base_y = self.origin_y + (c.y + 0.5) * cell
		local fill_color = PIECE_FILL[c.color] or PIECE_FILL[1]
		local hi_color = PIECE_HI[c.color] or PIECE_HI[1]

		local fill = make_box(
			vmath.vector3(base_x, base_y, 0.6),
			vmath.vector3(cell, cell, 0),
			vmath.vector4(fill_color.x, fill_color.y, fill_color.z, 1)
		)
		local hi = make_box(
			vmath.vector3(base_x, base_y + (cell - hi_h) * 0.5, 0.62),
			vmath.vector3(cell, hi_h, 0),
			vmath.vector4(hi_color.x, hi_color.y, hi_color.z, 1)
		)
		gui.set_pivot(fill, gui.PIVOT_CENTER)
		gui.set_pivot(hi, gui.PIVOT_CENTER)

		local delay = c.order * stagger
		if delay > last then last = delay end

		cubes[i] = {
			fill = fill,
			hi = hi,
			fill_color = fill_color,
			hi_color = hi_color,
			from_x = base_x,
			from_y = base_y,
			to_x = to_x,
			to_y = to_y,
			delay = delay,
		}
	end

	self.clear_anim = {
		t = 0,
		cubes = cubes,
		count = #cells,
		moves = moves,
		duration = last + CLEAR_CUBE_DURATION,
	}
end

--- Удаляет узлы сдвигающихся кубиков.
local function clear_move_nodes(self)
	if self.move_anim then
		for i = 1, #self.move_anim.cubes do
			local c = self.move_anim.cubes[i]
			gui.delete_node(c.fill)
			gui.delete_node(c.hi)
		end
		self.move_anim = nil
	end
end

--- Запускает анимацию сдвига оставшихся кубиков к ближайшей стороне поля.
local function start_move_anim(self, moves)
	clear_move_nodes(self)

	-- Кубики, которые сейчас сдвигаются, убираем из промежуточного поля:
	-- дальше их рисуют отдельные узлы, иначе было бы двойное изображение.
	if self.board_render then
		for i = 1, #moves do
			local m = moves[i]
			self.board_render[m.from_y][m.from_x] = 0
		end
		upload_board(self)
	end

	local cell = self.cell
	local hi_h = math.max(1, cell * PIECE_HI_R)

	local cubes = {}
	for i = 1, #moves do
		local m = moves[i]
		local from_x = self.origin_x + m.from_x * cell
		local from_y = self.origin_y + m.from_y * cell
		local to_x = self.origin_x + m.to_x * cell
		local to_y = self.origin_y + m.to_y * cell
		local fill_color = PIECE_FILL[m.color] or PIECE_FILL[1]
		local hi_color = PIECE_HI[m.color] or PIECE_HI[1]

		local fill = make_box(
			vmath.vector3(from_x, from_y, 0.35),
			vmath.vector3(cell, cell, 0),
			fill_color
		)
		local hi = make_box(
			vmath.vector3(from_x, from_y + cell - hi_h, 0.37),
			vmath.vector3(cell, hi_h, 0),
			hi_color
		)

		cubes[i] = {
			fill = fill,
			hi = hi,
			from_x = from_x,
			from_y = from_y,
			to_x = to_x,
			to_y = to_y,
		}
	end

	self.move_anim = { t = 0, cubes = cubes }
end

--- Пересоздаёт узлы детали под её текущую форму.
local function build_piece_nodes(self)
	clear_piece_nodes(self)
	local piece = self.piece
	if not piece then
		return
	end

	local cell = self.cell
	local hi_h = math.max(1, cell * PIECE_HI_R)
	local nodes = {}
	for i = 1, #piece.cells do
		local fill = make_box(
			vmath.vector3(0, 0, 0.5),
			vmath.vector3(cell, cell, 0),
			PIECE_FILL[piece.color] or PIECE_FILL[1]
		)
		local hi = make_box(
			vmath.vector3(0, 0, 0.52),
			vmath.vector3(cell, hi_h, 0),
			PIECE_HI[piece.color] or PIECE_HI[1]
		)
		nodes[i] = {
			fill = fill,
			hi = hi,
			cx = piece.cells[i][1],
			cy = piece.cells[i][2],
		}
	end
	self.piece_nodes = nodes
	snap_piece_nodes(self)
end

-- Предварительное объявление: touch_xy() использует резервный путь через
-- raw_touch_xy(), которая определена ниже.
local raw_touch_xy

--- Экранные координаты указателя (физические пиксели экрана).
local function raw_screen_xy(action)
	local entry = action.touch and action.touch[1]
	local sx = action.screen_x or (entry and entry.screen_x)
	local sy = action.screen_y or (entry and entry.screen_y)
	return sx, sy
end

--- Координаты указателя в системе координат сцены (эталонные единицы 420x800).
--- Движок отдаёт action.x/y растянутыми на всё окно (как при ADJUST_STRETCH),
--- что не совпадает с визуальным положением узлов при ADJUST_FIT. Поэтому берём
--- экранные координаты и переводим их через gui.screen_to_local(): для корневого
--- узла функция возвращает координаты сцены, уже учитывая adjust-режим,
--- масштаб, поля (letterbox), safe-area и DPI.
local function touch_xy(self, action)
	local sx, sy = raw_screen_xy(action)
	if sx ~= nil and sy ~= nil and self.board_node then
		local p = gui.screen_to_local(self.board_node, vmath.vector3(sx, sy, 0))
		return p.x, p.y
	end

	-- Запасной путь, если экранных координат нет: логические координаты экшена.
	return raw_touch_xy(action)
end

--- Согласование слова «кубик» с числом.
local function cubes_word(n)
	local m10 = n % 10
	local m100 = n % 100
	if m10 == 1 and m100 ~= 11 then
		return "кубик"
	end
	if m10 >= 2 and m10 <= 4 and (m100 < 12 or m100 > 14) then
		return "кубика"
	end
	return "кубиков"
end

--- Счётчики кубиков: сколько осталось разобрать и сколько уже разобрано.
local function update_hud(self)
	local removed = self.removed_cubes or 0
	if removed == self.shown_removed then
		return
	end
	self.shown_removed = removed

	local left = game.TOTAL_CELLS - removed
	if left < 0 then
		left = 0
	end

	gui.set_text(self.title, "Осталось разобрать " .. tostring(left) .. " " .. cubes_word(left))
	gui.set_text(self.status, "Разобрано " .. tostring(removed) .. " " .. cubes_word(removed))
end

--- HUD: координаты заданы в эталонных единицах сцены (BASE_W x BASE_H),
--- поэтому их пропорции не зависят от фактического размера окна.
local function build_hud(self)
	local w = self.scene_w
	local h = self.scene_h

	if self.title then
		gui.delete_node(self.title)
		gui.delete_node(self.hint)
		gui.delete_node(self.status)
	end
	if self.score then
		gui.delete_node(self.score)
		self.score = nil
	end
	if self.heading then
		gui.delete_node(self.heading)
		self.heading = nil
	end

	-- Сверху — заголовок и счётчик оставшихся кубиков,
	-- снизу — счётчик уже разобранных.
	self.heading = make_label(vmath.vector3(w / 2, h - h * 0.05, 0.1), "КВАДРОК", gui.PIVOT_N, COLOR_TEXT)
	self.title = make_label(vmath.vector3(w / 2, h - h * 0.105, 0.1), "", gui.PIVOT_N, COLOR_TEXT)
	self.status = make_label(vmath.vector3(w / 2, h * 0.095, 0.1), "", gui.PIVOT_S, COLOR_TEXT_DIM)
	-- Сохраняем актуальную подсказку при пересоздании узла (например, после resize).
	self.hint = make_label(
		vmath.vector3(w / 2, h * 0.05, 0.1),
		self.hint_text or HINT_PLAY,
		gui.PIVOT_S,
		COLOR_TEXT_DIM
	)

	-- Размер шрифта пропорционален стороне поля (22 px при поле ~420 px).
	local font_scale = math.max(0.6, self.board_size / 420)

	local labels = { self.heading, self.title, self.status, self.hint }
	for i = 1, #labels do
		gui.set_scale(labels[i], vmath.vector3(font_scale, font_scale, 1))
	end

	-- Узлы пересозданы пустыми — заставляем счётчики перерисоваться.
	self.shown_removed = nil
	update_hud(self)
end

local function set_hint(self, text)
	if self.hint_text == text then
		return
	end
	self.hint_text = text
	gui.set_text(self.hint, text)
end

--- Удаляет табличку окончания партии.
local function clear_overlay(self)
	if self.overlay then
		for i = 1, #self.overlay do
			gui.delete_node(self.overlay[i])
		end
		self.overlay = nil
	end
end

--- Рисует табличку окончания партии по центру поля: заголовок и подсказка
--- поверх затемнённой плашки. Табличка не мешает полю — она полупрозрачная.
local function build_overlay(self)
	clear_overlay(self)

	local info = self.overlay_info
	if not info then
		return
	end

	local w = self.scene_w
	local cx = w * 0.5
	local cy = self.origin_y + self.board_size * 0.5

	local panel_w = w * 0.88
	local panel_h = math.max(96, self.board_size * 0.30)
	local font_scale = math.max(0.6, self.board_size / 420)

	local nodes = {}
	nodes[#nodes + 1] = make_box(
		vmath.vector3(cx - panel_w * 0.5, cy - panel_h * 0.5, 0.7),
		vmath.vector3(panel_w, panel_h, 0),
		vmath.vector4(0.06, 0.09, 0.13, 0.94)
	)

	local title = make_label(
		vmath.vector3(cx, cy + panel_h * 0.14, 0.72),
		info.title,
		gui.PIVOT_CENTER,
		COLOR_TEXT
	)
	gui.set_scale(title, vmath.vector3(font_scale * 1.05, font_scale * 1.05, 1))
	nodes[#nodes + 1] = title

	local hint = make_label(
		vmath.vector3(cx, cy - panel_h * 0.20, 0.72),
		info.hint,
		gui.PIVOT_CENTER,
		COLOR_TEXT_DIM
	)
	gui.set_scale(hint, vmath.vector3(font_scale * 0.9, font_scale * 0.9, 1))
	nodes[#nodes + 1] = hint

	self.overlay = nodes
end

local function refresh(self)
	if self.state ~= "gameover" then
		self.danger_target = game.danger(self.board)
	end
	upload_board(self)
	-- Перекрашиваем контур сразу, чтобы после рестарта и ресайза цвет
	-- соответствовал текущему состоянию поля.
	update_frame(self)
	update_hud(self)
end

--- Можно ли оставить деталь в текущей позиции:
--- все клетки свободны, зона появления не задета и есть опора
--- (граница поля или ранее поставленная деталь).
local function drop_supported(self)
	local piece = self.piece
	if not piece then
		return false
	end
	return game.can_drop(self.board, piece.cells, piece.x, piece.y)
		and game.has_support(self.board, piece.cells, piece.x, piece.y)
end

--- Виды окончания партии.
local OVER_LOSE = "lose"
local OVER_WIN = "win"
local OVER_WIN_MAX = "win_max"

local OVERLAY_TEXT = {
	[OVER_LOSE] = { title = LOSE_TITLE, hint = LOSE_HINT },
	[OVER_WIN] = { title = WIN_TITLE, hint = WIN_HINT },
	[OVER_WIN_MAX] = { title = WIN_MAX_TITLE, hint = WIN_MAX_HINT },
}

--- Завершает партию и показывает табличку.
--- kind — OVER_LOSE, OVER_WIN или OVER_WIN_MAX; is_loss подсвечивает контур
--- красным (зона появления заблокирована).
local function game_over(self, kind, is_loss)
	self.state = "gameover"
	self.piece = nil
	self.drag = nil
	self.return_anim = nil
	clear_piece_nodes(self)

	-- Досрочно дорисовываем сдвиг кубиков, чтобы поле под табличкой было
	-- в конечном состоянии.
	if self.move_anim then
		clear_move_nodes(self)
		self.board_render = nil
	end

	if is_loss then
		self.danger_target = 1
		self.danger = 1
	end

	local text = OVERLAY_TEXT[kind] or OVERLAY_TEXT[OVER_LOSE]
	self.over_kind = kind
	self.overlay_info = { title = text.title, hint = text.hint }
	build_overlay(self)
	set_hint(self, text.hint)
	refresh(self)
end

-- Предварительные объявления: эти функции определяются ниже, но нужны здесь.
local restart, advance_level

--- Реакция на тап после окончания партии: победа ведёт на следующий уровень,
--- поражение — на повтор текущего.
local function continue_after_over(self)
	if self.over_kind == OVER_WIN then
		advance_level(self)
	else
		restart(self)
	end
end

--- Появление новой фигуры в центре зоны.
local function spawn(self)
	local piece = game.random_piece()
	local x, y = game.spawn_pos(piece)

	if not game.can_place(self.board, piece.cells, x, y) then
		game_over(self, OVER_LOSE, true)
		return
	end

	-- Если деталь некуда поставить с опорой, партия исчерпана.
	if not game.has_any_drop(self.board, piece) then
		game_over(self, OVER_LOSE, true)
		return
	end

	piece.x = x
	piece.y = y
	self.piece = piece
	self.drag = nil
	self.return_anim = nil
	build_piece_nodes(self)
	-- В центре у детали ещё нет опоры, но приглушение включается только
	-- во время перетаскивания, поэтому подсвечиваем её обычным цветом.
	color_piece_nodes(self, true)
	set_hint(self, HINT_PLAY)
	refresh(self)
end

--- Отпускание детали: остаётся на поле только при наличии опоры.
--- Иначе улетает обратно в центр зоны появления.
local function release_piece(self)
	local piece = self.piece
	if not piece then
		return
	end

	if drop_supported(self) then
		game.place(self.board, piece.cells, piece.x, piece.y, piece.color)

		-- Полностью заполненные ряды и столбцы убираются с поля.
		local cleared, rows, cols = game.clear_lines(self.board)

		self.piece = nil
		clear_piece_nodes(self)

		if #cleared > 0 then
			-- Пока идёт анимация, поле рисуется сразу после удаления линий,
			-- но ещё без сдвига: сдвигающиеся кубики пока стоят на месте.
			self.board_render = game.clone_board(self.board)
			local moves = game.collapse(self.board, rows, cols)
			refresh(self)

			-- Кубики каскадом улетают в центр поля; сдвиг оставшихся,
			-- счётчик и следующая деталь начнутся после завершения анимации.
			set_hint(self, HINT_CLEAR)
			start_clear_anim(self, cleared, moves)
			return
		end

		refresh(self)
		spawn(self)
		return
	end

	-- Возврат в центр: плавно, но целевая позиция — клетки зоны появления.
	local sx, sy = game.spawn_pos(piece)
	local from_x = self.origin_x + piece.x * self.cell
	local from_y = self.origin_y + piece.y * self.cell
	local to_x = self.origin_x + sx * self.cell
	local to_y = self.origin_y + sy * self.cell

	color_piece_nodes(self, false)
	set_hint(self, HINT_DRAG_BAD)

	if math.abs(from_x - to_x) < 0.5 and math.abs(from_y - to_y) < 0.5 then
		piece.x = sx
		piece.y = sy
		snap_piece_nodes(self)
		color_piece_nodes(self, true)
		set_hint(self, HINT_PLAY)
		return
	end

	self.return_anim = {
		t = 0,
		dur = RETURN_DURATION,
		from_x = from_x,
		from_y = from_y,
		to_x = to_x,
		to_y = to_y,
		sx = sx,
		sy = sy,
	}
end

--- Готовит чистое поле текущего уровня и запускает новую партию.
--- Пересоздаёт узлы поля, контура и HUD, потому что при смене уровня
--- меняется размер поля (и, значит, размер клетки, текстура и разметка).
local function start_round(self)
	self.board = game.new_board()
	self.board_render = nil
	self.removed_cubes = 0
	self.danger = 0
	self.danger_target = 0
	self.shown_removed = nil
	self.state = "play"
	self.drag = nil
	self.return_anim = nil
	self.piece = nil
	self.overlay_info = nil
	clear_piece_nodes(self)
	clear_fly_nodes(self)
	clear_move_nodes(self)
	clear_overlay(self)

	-- Геометрия, текстура и разметка зависят от текущего размера поля.
	relayout(self)
	build_board_node(self)
	build_hud(self)
	build_frame(self)
	update_frame(self)
	update_hud(self)
	spawn(self)
end

--- Рестарт: та же партия заново на текущем уровне.
restart = function(self)
	start_round(self)
end

--- Переход на следующий уровень после победы: поле больше на 2 клетки.
--- Достигнутый размер сохраняется на устройстве, чтобы прогресс не терялся.
advance_level = function(self)
	local next_size = game.next_field_size(game.FIELD_SIZE)
	if next_size then
		game.set_field_size(next_size)
		progress.save_field_size(next_size)
	end
	start_round(self)
end

function init(self)
	-- Восстанавливаем прогресс с устройства: игра продолжается с того поля,
	-- на котором игрок остановился в прошлый раз.
	local saved = progress.load_field_size()
	if saved then
		game.set_field_size(saved)
	else
		game.set_field_size(game.MIN_FIELD_SIZE)
	end

	self.removed_cubes = 0
	self.state = "play"
	self.board = game.new_board()
	self.board_render = nil
	self.danger = 0
	self.danger_target = 0
	self.shown_removed = nil
	self.drag = nil
	self.return_anim = nil
	self.overlay_info = nil

	prepare_blocks()
	prepare_piece_colors()
	relayout(self)
	build_board_node(self)
	build_hud(self)
	build_frame(self)
	spawn(self)

	msg.post(".", "acquire_input_focus")
end

--- Каскадное исчезновение кубиков в центре поля.
local function update_clear_anim(self, dt)
	local anim = self.clear_anim
	if not anim then
		return
	end

	anim.t = anim.t + dt

	local cell = self.cell
	local hi_h = math.max(1, cell * PIECE_HI_R)

	for i = 1, #anim.cubes do
		local c = anim.cubes[i]
		local k = (anim.t - c.delay) / CLEAR_CUBE_DURATION
		if k < 0 then
			k = 0
		elseif k > 1 then
			k = 1
		end

		-- Кубик улетает к центру поля, уменьшаясь и растворяясь.
		local e = k * k
		local x = lerp(c.from_x, c.to_x, e)
		local y = lerp(c.from_y, c.to_y, e)

		local shrink = 1 - k
		local size = cell * (0.25 + 0.75 * shrink)
		local alpha = 1 - k * k * k

		gui.set_position(c.fill, vmath.vector3(x, y, 0.6))
		gui.set_size(c.fill, vmath.vector3(size, size, 0))
		gui.set_color(c.fill, vmath.vector4(
			c.fill_color.x, c.fill_color.y, c.fill_color.z, alpha
		))

		local hi_size = hi_h * (0.25 + 0.75 * shrink)
		gui.set_position(c.hi, vmath.vector3(x, y + size * 0.5 - hi_size * 0.5, 0.62))
		gui.set_size(c.hi, vmath.vector3(size, hi_size, 0))
		gui.set_color(c.hi, vmath.vector4(
			c.hi_color.x, c.hi_color.y, c.hi_color.z, alpha
		))
	end

	if anim.t >= anim.duration then
		local count = anim.count
		local moves = anim.moves
		clear_fly_nodes(self)

		self.removed_cubes = (self.removed_cubes or 0) + count
		update_hud(self)

		-- Сдвиг оставшихся кубиков: показывает узлы, поле уже содержит
		-- конечное состояние, а буфер рисуется из промежуточного.
		if moves and #moves > 0 then
			start_move_anim(self, moves)
		else
			self.board_render = nil
			upload_board(self)
		end

		if self.removed_cubes >= game.TOTAL_CELLS then
			-- Победа: если поле уже максимального размера, дальше усложнять
			-- некуда — показываем соответствующую табличку.
			local kind = OVER_WIN
			if game.FIELD_SIZE >= game.MAX_FIELD_SIZE then
				kind = OVER_WIN_MAX
			end
			game_over(self, kind, false)
			return
		end

		if not self.move_anim then
			set_hint(self, HINT_PLAY)
			spawn(self)
		end
	end
end

--- Анимация сдвига оставшихся кубиков к ближайшей стороне поля.
local function update_move_anim(self, dt)
	local anim = self.move_anim
	if not anim then
		return
	end

	anim.t = anim.t + dt
	local k = anim.t / MOVE_CUBE_DURATION
	if k > 1 then k = 1 end
	local e = 1 - (1 - k) * (1 - k)

	local cell = self.cell
	local hi_h = math.max(1, cell * PIECE_HI_R)

	for i = 1, #anim.cubes do
		local c = anim.cubes[i]
		local x = lerp(c.from_x, c.to_x, e)
		local y = lerp(c.from_y, c.to_y, e)
		gui.set_position(c.fill, vmath.vector3(x, y, 0.35))
		gui.set_position(c.hi, vmath.vector3(x, y + cell - hi_h, 0.37))
	end

	if k >= 1 then
		clear_move_nodes(self)
		self.board_render = nil
		upload_board(self)

		if self.state ~= "gameover" then
			set_hint(self, HINT_PLAY)
			spawn(self)
		end
	end
end

function update(self, dt)
	-- Анимации уборки и сдвига кубиков блокируют ввод до своего завершения.
	if self.clear_anim then
		update_clear_anim(self, dt)
	end
	if self.move_anim then
		update_move_anim(self, dt)
	end

	-- Анимация возврата детали в центр зоны.
	local anim = self.return_anim
	if anim then
		anim.t = anim.t + dt
		local k = anim.t / anim.dur
		if k > 1 then k = 1 end
		-- Плавное замедление в конце.
		local e = 1 - (1 - k) * (1 - k) * (1 - k)
		position_piece_nodes(
			self,
			lerp(anim.from_x, anim.to_x, e),
			lerp(anim.from_y, anim.to_y, e)
		)
		if k >= 1 then
			self.return_anim = nil
			local piece = self.piece
			if piece then
				piece.x = anim.sx
				piece.y = anim.sy
				snap_piece_nodes(self)
				color_piece_nodes(self, true)
			end
			if self.state ~= "gameover" then
				set_hint(self, HINT_PLAY)
			end
		end
	end

	local target = self.danger_target or 0

	-- Плавное приближение к целевому значению.
	local step = math.min(1, dt * 3)
	local next_value = self.danger + (target - self.danger) * step
	if math.abs(next_value - self.danger) < 0.0005 then
		next_value = target
	end

	if next_value ~= self.danger then
		self.danger = next_value
		update_frame(self)
		update_hud(self)
	end
end

--- Логические координаты указателя: сначала плоские поля action, затем touch.
local function raw_touch_xy(action)
	if action.x ~= nil and action.y ~= nil then
		return action.x, action.y
	end
	local entry = action.touch and action.touch[1]
	if entry and entry.x ~= nil and entry.y ~= nil then
		return entry.x, entry.y
	end
	return nil, nil
end

--- Клетка поля под точкой касания (дробные координаты в клетках).
local function board_point(self, x, y)
	return (x - self.origin_x) / self.cell, (y - self.origin_y) / self.cell
end

--- Идентификатор касания: в новых версиях Defold он есть и в action.id,
--- и в записи action.touch; поддерживаем оба варианта.
local function touch_id(action)
	if action.id ~= nil then
		return action.id
	end
	local entry = action.touch and action.touch[1]
	return entry and entry.id or nil
end

--- Есть ли клетка (cx, cy) в составе детали.
local function piece_has_cell(piece, cx, cy)
	for i = 1, #piece.cells do
		if piece.x + piece.cells[i][1] == cx and piece.y + piece.cells[i][2] == cy then
			return true
		end
	end
	return false
end

function on_input(self, action_id, action)
	if action_id ~= hash("touch") then
		return false
	end

	-- Пока кубики убираются/сдвигаются или деталь летит в центр, ввод
	-- игнорируем (кроме тапа после окончания партии — он продолжает игру).
	if self.clear_anim or self.move_anim then
		if self.state == "gameover" and action.pressed then
			continue_after_over(self)
		end
		return true
	end

	if self.return_anim then
		return true
	end

	if action.pressed then
		if self.state == "gameover" then
			continue_after_over(self)
			return true
		end
		local piece = self.piece
		if not piece or self.drag then
			return true
		end

		local sx, sy = touch_xy(self, action)
		if sx == nil then
			return true
		end

		local bx, by = board_point(self, sx, sy)
		local cx = math.floor(bx)
		local cy = math.floor(by)
		if not piece_has_cell(piece, cx, cy) then
			return true
		end

		-- Захват: запоминаем дробное смещение точки внутри детали, чтобы она
		-- не «прыгала» при первом же сдвиге.
		self.drag = {
			id = touch_id(action),
			off_x = bx - piece.x,
			off_y = by - piece.y,
		}
		color_piece_nodes(self, drop_supported(self))
		set_hint(self, drop_supported(self) and HINT_DRAG_OK or HINT_DRAG_BAD)
		return true
	end

	if not self.drag then
		return true
	end

	if self.drag.id ~= nil and touch_id(action) ~= self.drag.id then
		return true
	end

	-- При отпускании позицию не пересчитываем: событие `released` может прийти
	-- с координатами, отличающимися от последнего движения (например, за
	-- пределами canvas), из-за чего деталь «прыгала» бы перед фиксацией.
	-- Фиксируем уже достигнутую квантизованную позицию.
	if action.released then
		self.drag = nil
		release_piece(self)
		return true
	end

	-- Defold присылает экшен каждый кадр, пока палец на экране: отдельного
	-- признака `moved` у touch-экшена нет, поэтому двигаем деталь по
	-- актуальным координатам указателя.
	local sx, sy = touch_xy(self, action)
	if sx ~= nil then
		local bx, by = board_point(self, sx, sy)
		-- Квантизация: деталь двигается по клеткам, оставаясь под пальцем.
		local want_x = math.floor(bx - self.drag.off_x + 0.5)
		local want_y = math.floor(by - self.drag.off_y + 0.5)
		local piece = self.piece
		if piece then
			want_x, want_y = game.clamp_pos(piece, want_x, want_y)

			-- Скольжение вдоль препятствий: если целевая клетка занята, деталь
			-- продолжает двигаться по свободной оси, а не застревает.
			local px, py = piece.x, piece.y
			if game.can_place(self.board, piece.cells, want_x, want_y) then
				px, py = want_x, want_y
			elseif game.can_place(self.board, piece.cells, want_x, py) then
				px = want_x
			elseif game.can_place(self.board, piece.cells, px, want_y) then
				py = want_y
			end

			if px ~= piece.x or py ~= piece.y then
				piece.x = px
				piece.y = py
				snap_piece_nodes(self)
				local ok = drop_supported(self)
				color_piece_nodes(self, ok)
				set_hint(self, ok and HINT_DRAG_OK or HINT_DRAG_BAD)
			end
		end
	end

	return true
end

function on_message(self, message_id, message, sender)
	if message_id == hash("window_resized") then
		-- Ресайз во время анимаций: завершаем их досрочно, иначе пиксельные
		-- координаты кубиков разъедутся с новой сеткой поля.
		if self.move_anim then
			clear_move_nodes(self)
			self.board_render = nil
		end

		if self.clear_anim then
			local count = self.clear_anim.count
			clear_fly_nodes(self)
			self.board_render = nil
			self.removed_cubes = (self.removed_cubes or 0) + count
			update_hud(self)
		end

		if not self.piece and self.state ~= "gameover" then
			spawn(self)
			if self.state == "gameover" then
				return
			end
		end

		-- Ресайз во время возврата: сразу доводим деталь до центра,
		-- чтобы пиксельные координаты анимации не разъехались с новой сеткой.
		if self.return_anim and self.piece then
			local piece = self.piece
			piece.x = self.return_anim.sx
			piece.y = self.return_anim.sy
			self.return_anim = nil
			self.drag = nil
			if self.state ~= "gameover" then
				set_hint(self, HINT_PLAY)
			end
		end
		relayout(self)
		build_board_node(self)
		build_hud(self)
		build_frame(self)
		build_piece_nodes(self)
		build_overlay(self)
		refresh(self)
	elseif message_id == hash("restart") then
		restart(self)
	end
end
